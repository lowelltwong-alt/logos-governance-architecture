{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "logos.doctrine-marathon.jewish-context-pack.v3",
  "title": "Period- and community-specific Jewish context pack",
  "description": "object_type=jewish_context_pack_schema; trust_zone=proposed; lifecycle_status=active; provenance_note=Created 2026-08-27 by Codex root after independent non-flattening review; reason_for_inclusion=Require named communities, periods, geographies, self or contemporary sources, later-source bridges, disputes, and nonnormative boundaries.",
  "type": "object",
  "required": ["schema_version", "pack_id", "community_ref", "community_display", "period", "geographies", "primary_self_or_contemporary_source_refs", "later_source_uses", "teaching_claim_scope", "internal_diversity_and_disputes", "expert_pack_ref", "qualification_receipt_ref", "normative_force", "status", "pack_digest"],
  "properties": {
    "schema_version": {"const": "logos.doctrine-marathon.jewish-context-pack.v3"},
    "pack_id": {"type": "string", "pattern": "^JCTX-[A-Za-z0-9._-]+$"},
    "community_ref": {"type": "string", "pattern": "^community:[A-Za-z0-9._-]+$"},
    "community_display": {"type": "string", "minLength": 3, "not": {"pattern": "^(?i:the jews|jews|ancient jews|judaism)$"}},
    "period": {"type": "object", "required": ["start_display", "end_display", "uncertainty"], "properties": {"start_display": {"type": "string"}, "end_display": {"type": "string"}, "uncertainty": {"type": "string"}}, "additionalProperties": false},
    "geographies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
    "primary_self_or_contemporary_source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^source-record:SRC-[A-Za-z0-9._-]+$"}},
    "later_source_uses": {"type": "array", "items": {"type": "object", "required": ["source_ref", "earlier_target_claim", "bridge_method", "limitations"], "properties": {"source_ref": {"type": "string", "pattern": "^source-record:SRC-[A-Za-z0-9._-]+$"}, "earlier_target_claim": {"type": "string", "minLength": 10}, "bridge_method": {"type": "string", "minLength": 20}, "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}}}, "additionalProperties": false}},
    "teaching_claim_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 10}},
    "internal_diversity_and_disputes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 10}},
    "expert_pack_ref": {"type": "string", "minLength": 3},
    "qualification_receipt_ref": {"type": "string", "minLength": 3},
    "normative_force": {"const": "none"},
    "status": {"enum": ["candidate", "specialist_review_required", "qualified", "disputed", "stale", "invalidated"]},
    "pack_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
