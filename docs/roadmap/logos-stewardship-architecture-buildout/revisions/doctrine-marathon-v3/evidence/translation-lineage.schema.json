{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "logos.doctrine-marathon.translation-lineage.v3",
  "title": "Doctrine Marathon translation lineage",
  "description": "object_type=translation_lineage_schema; trust_zone=proposed; lifecycle_status=active; provenance_note=Created 2026-08-27 by Codex root after independent translation-boundary review; reason_for_inclusion=Keep witness identity, transcription, alignment, translation, and specialist approval separate.",
  "type": "object",
  "required": ["schema_version", "translation_lineage_id", "source_record_ref", "source_record_digest", "source_record_object_digest", "source_language", "target_language", "edition_or_witness_id", "segment_locators", "translator_or_method", "generated_by_ai", "review_scope_digest", "specialist_review_receipt_refs", "specialist_review_receipt_digests", "human_approval_receipt_ref", "human_approval_receipt_digest", "status", "lineage_digest"],
  "properties": {
    "schema_version": {"const": "logos.doctrine-marathon.translation-lineage.v3"},
    "translation_lineage_id": {"type": "string", "pattern": "^TLIN-[A-Za-z0-9._-]+$"},
    "source_record_ref": {"type": "string", "pattern": "^source-record:SRC-[A-Za-z0-9._-]+$"},
    "source_record_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_record_object_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_language": {"type": "string", "minLength": 2},
    "target_language": {"type": "string", "minLength": 2},
    "edition_or_witness_id": {"type": "string", "minLength": 3},
    "segment_locators": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
    "translator_or_method": {"type": "string", "minLength": 3},
    "generated_by_ai": {"type": "boolean"},
    "review_scope_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "specialist_review_receipt_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^evidence-review:EREV-[A-Za-z0-9._-]+$"}},
    "specialist_review_receipt_digests": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "human_approval_receipt_ref": {"type": ["string", "null"], "pattern": "^human-decision:HDEC-[A-Za-z0-9._-]+$"},
    "human_approval_receipt_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "status": {"enum": ["candidate", "specialist_reviewed", "human_approved", "disputed", "stale", "invalidated"]},
    "lineage_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"enum": ["specialist_reviewed", "human_approved"]}}}, "then": {"properties": {"specialist_review_receipt_refs": {"minItems": 1}, "specialist_review_receipt_digests": {"minItems": 1}}}},
    {"if": {"properties": {"status": {"const": "human_approved"}}}, "then": {"properties": {"human_approval_receipt_ref": {"type": "string", "minLength": 3}, "human_approval_receipt_digest": {"type": "string"}}}}
  ],
  "additionalProperties": false
}
