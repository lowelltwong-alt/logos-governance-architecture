{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "logos.doctrine-marathon.campaign-completion-receipt.v3",
  "title": "Doctrine Marathon terminal completion receipt",
  "description": "object_type=campaign_completion_receipt_schema; trust_zone=proposed; lifecycle_status=active; provenance_note=Created 2026-08-27 by Codex root after frontier red-team review; reason_for_inclusion=Require exact unit, audit, graph, debt, checkpoint, and human-decision evidence before CAMPAIGN_COMPLETE.",
  "type": "object",
  "required": ["schema_version", "receipt_id", "definition_ref", "definition_digest", "checkpoint_ref", "checkpoint_digest", "completed_at", "ledger_snapshot_ref", "ledger_snapshot_digest", "ledger_prefix_event_hash", "graph_snapshot_ref", "graph_snapshot_digest", "debt_registry_ref", "debt_registry_digest", "evidence_registry_ref", "evidence_registry_digest", "unit_completion_rows", "open_blocking_debt_ids", "open_high_risk_debt_ids", "nonfresh_load_bearing_node_ids", "unresolved_required_claim_ids", "human_completion_decision_ref", "human_completion_decision_digest", "status", "receipt_digest"],
  "properties": {
    "schema_version": {"const": "logos.doctrine-marathon.campaign-completion-receipt.v3"},
    "receipt_id": {"type": "string", "pattern": "^DMV3-COMPREC-[A-Za-z0-9._-]+$"},
    "definition_ref": {"type": "string", "pattern": "^state/completion-definitions/[A-Za-z0-9._-]+\\.json$"},
    "definition_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "checkpoint_ref": {"type": "string", "pattern": "^state/(?:checkpoints|examples)/[A-Za-z0-9._-]+\\.json$"},
    "checkpoint_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "completed_at": {"type": "string", "format": "date-time"},
    "ledger_snapshot_ref": {"const": "events/event-ledger.json"},
    "ledger_snapshot_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "ledger_prefix_event_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "graph_snapshot_ref": {"const": "graph/example-graph.json"},
    "graph_snapshot_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "debt_registry_ref": {"const": "debt/initial-review-debt.json"},
    "debt_registry_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "evidence_registry_ref": {"const": "evidence/evidence-registry.json"},
    "evidence_registry_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "unit_completion_rows": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["unit_id", "horizon_id", "output_class", "terminal_output_ref", "terminal_output_digest", "exit_audit_event_id", "exit_audit_event_hash", "qualified_review_event_ids", "status"], "properties": {"unit_id": {"type": "string"}, "horizon_id": {"type": "string"}, "output_class": {"type": "string"}, "terminal_output_ref": {"type": "string", "minLength": 3}, "terminal_output_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "exit_audit_event_id": {"type": "string", "pattern": "^DMV3-EVENT-[0-9]{4,}$"}, "exit_audit_event_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "qualified_review_event_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^DMV3-EVENT-[0-9]{4,}$"}}, "status": {"const": "accepted"}}, "additionalProperties": false}},
    "open_blocking_debt_ids": {"type": "array", "maxItems": 0},
    "open_high_risk_debt_ids": {"type": "array", "maxItems": 0},
    "nonfresh_load_bearing_node_ids": {"type": "array", "maxItems": 0},
    "unresolved_required_claim_ids": {"type": "array", "maxItems": 0},
    "human_completion_decision_ref": {"type": "string", "pattern": "^human-decision:HDEC-[A-Za-z0-9._-]+$"},
    "human_completion_decision_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "status": {"const": "pass"},
    "receipt_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
