{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "logos.doctrine-marathon.event.v3",
  "title": "Doctrine Marathon append-only event",
  "description": "object_type=marathon_event_schema; trust_zone=proposed; lifecycle_status=active; provenance_note=Created 2026-08-27 by Codex root; reason_for_inclusion=Preserve every material state transition and changed-input audit trigger across long-running work.",
  "type": "object",
  "required": ["event_id", "sequence", "occurred_at", "event_type", "actor_id", "input_digest", "affected_ids", "authority_ref", "details", "prior_event_hash", "event_hash"],
  "properties": {
    "event_id": {"type": "string", "pattern": "^DMV3-EVENT-[0-9]{4,}$"},
    "sequence": {"type": "integer", "minimum": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "event_type": {"enum": ["specification_created", "work_unit_classified", "completeness_entry", "role_assigned", "research_started", "material_trigger", "completeness_midflight", "candidate_created", "check_completed", "gap_discovered", "quarantined", "invalidated", "debt_opened", "human_decision", "completeness_exit", "checkpoint_frozen", "terminal_handoff"]},
    "actor_id": {"type": "string", "minLength": 2},
    "input_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "affected_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "authority_ref": {"type": "string", "minLength": 3},
    "details": {
      "type": "object",
      "properties": {
        "trigger_matrix_id": {"type": "string", "pattern": "^TR-[A-Z0-9-]+$"},
        "changed_input_digest": {"$ref": "#/$defs/digest"},
        "dependency_graph_ref": {"const": "graph/example-graph.json"},
        "dependency_graph_digest": {"$ref": "#/$defs/digest"},
        "direct_subject_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "affected_work_and_consumer_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "closure_digest": {"$ref": "#/$defs/digest"},
        "required_action_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "coverage_input_digest": {"$ref": "#/$defs/digest"},
        "requirement_and_assignment_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "completeness_assignment_bundle_ref": {"type": "string", "pattern": "^mesh/(?:examples|receipts)/[A-Za-z0-9._-]+\\.json$"},
        "completeness_assignment_bundle_digest": {"$ref": "#/$defs/digest"},
        "completeness_assignment_ref": {"type": "string", "pattern": "^role-assignment:DMV3-ROLE-[A-Za-z0-9._-]+$"},
        "completeness_assignment_digest": {"$ref": "#/$defs/digest"},
        "requirement_set_digest": {"$ref": "#/$defs/digest"},
        "prior_trigger_event_id": {"type": "string", "pattern": "^DMV3-EVENT-[0-9]{4,}$"},
        "trigger_event_hash": {"$ref": "#/$defs/digest"},
        "fresh_changed_input_digest": {"$ref": "#/$defs/digest"},
        "covered_affected_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "fresh_requirement_set_digest": {"$ref": "#/$defs/digest"},
        "action_assignment_bundle_ref": {"type": "string", "pattern": "^mesh/(?:examples|receipts)/[A-Za-z0-9._-]+\\.json$"},
        "action_assignment_bundle_digest": {"$ref": "#/$defs/digest"},
        "action_results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["action_id", "subject_ids", "result", "evidence_bindings", "checker_assignment_ref", "checker_assignment_digest", "checker_actor_instance_id", "checker_attempt_id", "result_digest"],
            "properties": {
              "action_id": {"type": "string", "minLength": 3},
              "subject_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
              "result": {"enum": ["pass_to_continue", "quarantine_and_replay"]},
              "evidence_bindings": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["ref", "digest"], "properties": {"ref": {"type": "string", "minLength": 3}, "digest": {"$ref": "#/$defs/digest"}}, "additionalProperties": false}},
              "checker_assignment_ref": {"type": "string", "pattern": "^role-assignment:DMV3-ROLE-[A-Za-z0-9._-]+$"},
              "checker_assignment_digest": {"$ref": "#/$defs/digest"},
              "checker_actor_instance_id": {"type": "string", "minLength": 3},
              "checker_attempt_id": {"type": "string", "minLength": 3},
              "result_digest": {"$ref": "#/$defs/digest"}
            },
            "additionalProperties": false
          }
        },
        "review_receipt_id": {"type": "string", "pattern": "^DMV3-REVIEW-[A-Za-z0-9._-]+$"},
        "reviewed_output_ref": {"type": "string", "minLength": 3},
        "reviewed_output_digest": {"$ref": "#/$defs/digest"},
        "requirement_event_id": {"type": "string", "pattern": "^DMV3-EVENT-[0-9]{4,}$"},
        "requirement_event_hash": {"$ref": "#/$defs/digest"},
        "assignment_bundle_ref": {"type": "string", "pattern": "^mesh/(?:examples|receipts)/[A-Za-z0-9._-]+\\.json$"},
        "assignment_bundle_digest": {"$ref": "#/$defs/digest"},
        "producer_assignment_ref": {"type": "string", "pattern": "^role-assignment:DMV3-ROLE-[A-Za-z0-9._-]+$"},
        "producer_assignment_digest": {"$ref": "#/$defs/digest"},
        "reviewer_assignment_refs": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^role-assignment:DMV3-ROLE-[A-Za-z0-9._-]+$"}},
        "required_capability_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}},
        "review_dimensions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
        "review_requirements_digest": {"$ref": "#/$defs/digest"},
        "evidence_bindings": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["ref", "digest"], "properties": {"ref": {"type": "string", "minLength": 3}, "digest": {"$ref": "#/$defs/digest"}}, "additionalProperties": false}},
        "evidence_set_digest": {"$ref": "#/$defs/digest"},
        "reviewer_decisions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["reviewer_assignment_ref", "reviewer_assignment_digest", "reviewer_actor_instance_id", "reviewer_attempt_id", "reviewed_output_digest", "requirement_event_hash", "review_requirements_digest", "evidence_set_digest", "decision", "decided_at", "expires_at", "review_digest"],
            "properties": {
              "reviewer_assignment_ref": {"type": "string", "pattern": "^role-assignment:DMV3-ROLE-[A-Za-z0-9._-]+$"},
              "reviewer_assignment_digest": {"$ref": "#/$defs/digest"},
              "reviewer_actor_instance_id": {"type": "string", "minLength": 3},
              "reviewer_attempt_id": {"type": "string", "minLength": 3},
              "reviewed_output_digest": {"$ref": "#/$defs/digest"},
              "requirement_event_hash": {"$ref": "#/$defs/digest"},
              "review_requirements_digest": {"$ref": "#/$defs/digest"},
              "evidence_set_digest": {"$ref": "#/$defs/digest"},
              "decision": {"enum": ["accepted", "rejected", "needs_revision", "abstained"]},
              "decided_at": {"type": "string", "format": "date-time"},
              "expires_at": {"type": ["string", "null"], "format": "date-time"},
              "review_digest": {"$ref": "#/$defs/digest"}
            },
            "additionalProperties": false
          }
        },
        "decision": {"enum": ["accepted", "rejected", "needs_revision", "abstained"]},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "review_authority_effect": {"const": "none"},
        "review_receipt_digest": {"$ref": "#/$defs/digest"},
        "final_output_digest": {"$ref": "#/$defs/digest"},
        "independently_rederived_requirements": {"const": true},
        "discovered_gap_and_replay_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "checkpoint_digest": {"$ref": "#/$defs/digest"},
        "terminal_status": {"enum": ["CONTINUE", "BLOCKED", "CAMPAIGN_COMPLETE"]},
        "exact_next_prompt_or_explicit_none_if_complete": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "prior_event_hash": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "event_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "allOf": [
    {"if": {"properties": {"event_type": {"const": "material_trigger"}}}, "then": {"properties": {"details": {"required": ["trigger_matrix_id", "changed_input_digest", "dependency_graph_ref", "dependency_graph_digest", "direct_subject_ids", "affected_work_and_consumer_ids", "closure_digest", "required_action_ids"]}}}},
    {"if": {"properties": {"event_type": {"const": "completeness_entry"}}}, "then": {"properties": {"details": {"required": ["coverage_input_digest", "requirement_and_assignment_refs", "completeness_assignment_bundle_ref", "completeness_assignment_bundle_digest", "completeness_assignment_ref", "completeness_assignment_digest", "required_capability_ids", "requirement_set_digest"]}}}},
    {"if": {"properties": {"event_type": {"const": "completeness_midflight"}}}, "then": {"properties": {"details": {"required": ["prior_trigger_event_id", "trigger_event_hash", "fresh_changed_input_digest", "dependency_graph_digest", "covered_affected_ids", "closure_digest", "completeness_assignment_bundle_ref", "completeness_assignment_bundle_digest", "completeness_assignment_ref", "completeness_assignment_digest", "required_capability_ids", "fresh_requirement_set_digest", "action_assignment_bundle_ref", "action_assignment_bundle_digest", "action_results"]}}}},
    {"if": {"properties": {"event_type": {"const": "check_completed"}}}, "then": {"properties": {"details": {"required": ["review_receipt_id", "reviewed_output_ref", "reviewed_output_digest", "requirement_event_id", "requirement_event_hash", "assignment_bundle_ref", "assignment_bundle_digest", "producer_assignment_ref", "producer_assignment_digest", "reviewer_assignment_refs", "required_capability_ids", "review_dimensions", "review_requirements_digest", "evidence_bindings", "evidence_set_digest", "reviewer_decisions", "decision", "reviewed_at", "review_authority_effect", "review_receipt_digest"]}}}},
    {"if": {"properties": {"event_type": {"const": "completeness_exit"}}}, "then": {"properties": {"details": {"required": ["final_output_digest", "independently_rederived_requirements", "discovered_gap_and_replay_refs", "completeness_assignment_bundle_ref", "completeness_assignment_bundle_digest", "completeness_assignment_ref", "completeness_assignment_digest", "required_capability_ids", "requirement_set_digest"]}}}},
    {"if": {"properties": {"event_type": {"const": "terminal_handoff"}}}, "then": {"properties": {"details": {"required": ["checkpoint_digest", "terminal_status", "exact_next_prompt_or_explicit_none_if_complete"]}}}}
  ],
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
  "additionalProperties": false
}
