    "runtime_activated": {"const": false},
    "research_started": {"const": false},
    "source_corpus_ingested": {"const": false},
    "doctrine_corpus_complete": {"const": false},
    "qualified_theological_authority": {"const": false},
    "human_review_required": {"const": true},
    "progress": {"type": "object", "required": ["research_units_completed", "doctrine_claims_promoted", "qualified_human_reviews_completed", "open_expert_review_debt"]},
    "evidence_routes": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string"}},
    "nonclaims": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
