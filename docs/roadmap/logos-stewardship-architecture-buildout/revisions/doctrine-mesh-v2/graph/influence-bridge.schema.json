{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logos.local/schemas/doctrine-influence-bridge-v2.json",
  "title": "DoctrineInfluenceBridge",
  "type": "object",
  "additionalProperties": false,
  "x-logos-metadata": {
    "object_type": "doctrine_influence_bridge_schema",
    "trust_zone": "proposed",
    "lifecycle_status": "specification_only",
    "provenance_note": "Created on 2026-08-24 by Codex root after adversarial influence-claim review.",
    "reason_for_inclusion": "Require dated, sourced contact, reception, rejection or reframing evidence instead of inferring influence from similarity."
  },
  "required": ["schema_version", "bridge_id", "source_concept_ref", "receiving_claim_ref", "source_dates", "receiving_dates", "geographies", "contact_mechanism", "contact_evidence_refs", "reception_state", "reception_evidence_refs", "similarity_only", "alternative_explanations", "counterevidence_refs", "uncertainty", "normative_force", "risk_floor", "human_gate_refs", "status"],
  "properties": {
    "schema_version": {"const": "logos.doctrine_influence_bridge.v2"},
    "bridge_id": {"type": "string", "pattern": "^DIB-[A-Z0-9-]+$"},
    "source_concept_ref": {"type": "string"}, "receiving_claim_ref": {"type": "string"},
    "source_dates": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "receiving_dates": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "geographies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "contact_mechanism": {"enum": ["direct_textual_use", "named_teacher_or_school", "institutional_contact", "translation_or_commentary_chain", "trade_migration_or_political_contact", "unknown"]},
    "contact_evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "reception_state": {"enum": ["documented_adoption", "documented_rejection", "documented_reframing", "possible_contact_only", "unknown"]},
    "reception_evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "similarity_only": {"const": false},
    "alternative_explanations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "counterevidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "uncertainty": {"type": "object", "required": ["tier", "reasons", "falsifiers"], "properties": {"tier": {"enum": ["low", "medium", "high", "unknown"]}, "reasons": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "falsifiers": {"type": "array", "minItems": 1, "items": {"type": "string"}}}, "additionalProperties": false},
    "normative_force": {"const": "none"}, "risk_floor": {"enum": ["high", "frontier"]},
    "human_gate_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "status": {"enum": ["candidate", "checked_descriptive_only", "blocked", "rejected", "superseded"]}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "checked_descriptive_only"}}, "required": ["status"]},
      "then": {
        "properties": {
          "contact_mechanism": {"enum": ["direct_textual_use", "named_teacher_or_school", "institutional_contact", "translation_or_commentary_chain", "trade_migration_or_political_contact"]},
          "reception_state": {"enum": ["documented_adoption", "documented_rejection", "documented_reframing"]}
        }
      }
    }
  ]
}
