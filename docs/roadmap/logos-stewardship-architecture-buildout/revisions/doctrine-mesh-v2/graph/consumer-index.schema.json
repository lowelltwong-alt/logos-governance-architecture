{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logos.local/schemas/doctrine-consumer-index-v2.json",
  "title": "DoctrineConsumerIndex",
  "type": "object",
  "additionalProperties": false,
  "x-logos-metadata": {
    "object_type": "doctrine_consumer_index_schema",
    "trust_zone": "proposed",
    "lifecycle_status": "specification_only",
    "provenance_note": "Created on 2026-08-24 by Codex root after adversarial stale-propagation review.",
    "reason_for_inclusion": "Make reverse consumers and affected-slice invalidation deterministic rather than author-supplied."
  },
  "required": ["schema_version", "index_id", "graph_snapshot_digest", "nodes", "forward_edges", "reverse_edges", "invalidations", "index_digest"],
  "properties": {
    "schema_version": {"const": "logos.doctrine_consumer_index.v2"},
    "index_id": {"type": "string"}, "graph_snapshot_digest": {"$ref": "#/$defs/digest"},
    "nodes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "forward_edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "reverse_edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "invalidations": {"type": "array", "items": {"type": "object", "required": ["root_ref", "root_revision", "reason", "computed_descendants", "computed_descendants_digest", "status"], "properties": {"root_ref": {"type": "string"}, "root_revision": {"type": "string"}, "reason": {"type": "string"}, "computed_descendants": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "computed_descendants_digest": {"$ref": "#/$defs/digest"}, "status": {"enum": ["quarantined", "revalidated", "superseded"]}}, "additionalProperties": false}},
    "index_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "edge": {"type": "object", "additionalProperties": false, "required": ["from", "to", "type", "evidence_ref"], "properties": {"from": {"type": "string"}, "to": {"type": "string"}, "type": {"type": "string"}, "evidence_ref": {"type": "string"}}}
  }
}
