{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logos.local/schemas/doctrine-mesh-independent-specification-review-v2.json",
  "title": "DoctrineMeshIndependentSpecificationReview",
  "type": "object",
  "additionalProperties": false,
  "x-logos-metadata": {
    "object_type": "doctrine_mesh_independent_specification_review_schema",
    "trust_zone": "proposed",
    "lifecycle_status": "specification_only",
    "provenance_note": "Created on 2026-08-24 by Codex root after final-gate semantic review.",
    "reason_for_inclusion": "Require an independent-review gate to bind the exact manifest, payload, lineage, findings, limitations, and non-authority state."
  },
  "required": ["metadata", "schema_version", "review_id", "revision_manifest_ref", "revision_manifest_digest", "payload_digest", "review_lineage_ref", "review_lineage_digest", "reviewer_lanes", "independence_status", "cross_provider_verified", "status", "finding_counts", "unresolved_runtime_boundaries", "runtime_activation_authorized", "research_authorized", "source_ingestion_authorized", "doctrine_decision_authorized", "cross_repository_write_authorized", "publication_authorized", "observed_at", "review_digest"],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_type", "trust_zone", "lifecycle_status", "provenance_note", "reason_for_inclusion"],
      "properties": {
        "object_type": {"const": "doctrine_mesh_independent_specification_review"},
        "trust_zone": {"const": "proposed"},
        "lifecycle_status": {"const": "independently_checked"},
        "provenance_note": {"type": "string", "minLength": 1},
        "reason_for_inclusion": {"type": "string", "minLength": 1}
      }
    },
    "schema_version": {"const": "logos.doctrine_mesh_independent_specification_review.v2"},
    "review_id": {"const": "DM-INDEPENDENT-REVIEW-002"},
    "revision_manifest_ref": {"const": "revision-manifest.yaml"},
    "revision_manifest_digest": {"$ref": "#/$defs/digest"},
    "payload_digest": {"$ref": "#/$defs/digest"},
    "review_lineage_ref": {"const": "evidence/independence/review-lineage.yaml"},
    "review_lineage_digest": {"$ref": "#/$defs/digest"},
    "reviewer_lanes": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "independence_status": {"const": "partly_verified_non_authorizing"},
    "cross_provider_verified": {"const": false},
    "status": {"enum": ["pass_specification_only", "blocked", "inconclusive"]},
    "finding_counts": {
      "type": "object", "additionalProperties": false,
      "required": ["critical", "high", "medium", "low"],
      "properties": {"critical": {"type": "integer", "minimum": 0}, "high": {"type": "integer", "minimum": 0}, "medium": {"type": "integer", "minimum": 0}, "low": {"type": "integer", "minimum": 0}}
    },
    "unresolved_runtime_boundaries": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "runtime_activation_authorized": {"const": false},
    "research_authorized": {"const": false},
    "source_ingestion_authorized": {"const": false},
    "doctrine_decision_authorized": {"const": false},
    "cross_repository_write_authorized": {"const": false},
    "publication_authorized": {"const": false},
    "observed_at": {"type": "string", "format": "date-time"},
    "review_digest": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "pass_specification_only"}}, "required": ["status"]},
      "then": {"properties": {"finding_counts": {"properties": {"critical": {"const": 0}, "high": {"const": 0}}, "required": ["critical", "high"]}}}
    }
  ],
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
