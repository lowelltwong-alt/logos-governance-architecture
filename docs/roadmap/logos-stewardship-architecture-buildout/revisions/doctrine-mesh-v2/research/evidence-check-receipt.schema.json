{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logos.local/schemas/doctrine-evidence-check-receipt-v2.json",
  "title": "DoctrineEvidenceCheckReceipt",
  "type": "object",
  "additionalProperties": false,
  "x-logos-metadata": {
    "object_type": "doctrine_evidence_check_receipt_schema",
    "trust_zone": "proposed",
    "lifecycle_status": "specification_only",
    "provenance_note": "Created on 2026-08-24 by Codex root after adversarial evidence-chain review.",
    "reason_for_inclusion": "Bind citation, source quality, entailment, counterevidence, representation, alignment, and rights checks to exact claim and source revisions without conflating them."
  },
  "required": ["schema_version", "receipt_id", "check_type", "claim", "assignment_ref", "assignment_digest", "checker_attempt_lineage_ref", "checker_attempt_lineage_digest", "source_manifest_bindings", "independent_source_access", "method_revision", "findings", "result", "authority_granted", "started_at", "completed_at", "receipt_digest"],
  "properties": {
    "schema_version": {"const": "logos.doctrine_evidence_check_receipt.v2"},
    "receipt_id": {"type": "string", "pattern": "^DEC-[A-Z0-9-]+$"},
    "check_type": {"enum": ["citation_locator", "source_quality", "claim_entailment_context", "counterevidence_challenge", "tradition_representation", "Jewish_representation_anti_projection", "goal_alignment_authority", "translation_fidelity", "rights_privacy_custody", "cross_repository_custody"]},
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["claim_id", "revision", "claim_digest", "exact_text_ref", "materiality"],
      "properties": {
        "claim_id": {"type": "string"},
        "revision": {"type": "string"},
        "claim_digest": {"$ref": "#/$defs/digest"},
        "exact_text_ref": {"type": "string"},
        "materiality": {"enum": ["non_material", "material", "unknown"]}
      }
    },
    "assignment_ref": {"type": "string"},
    "assignment_digest": {"$ref": "#/$defs/digest"},
    "checker_attempt_lineage_ref": {"type": "string"},
    "checker_attempt_lineage_digest": {"$ref": "#/$defs/digest"},
    "source_manifest_bindings": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["manifest_ref", "manifest_digest", "source_id", "source_revision", "exact_locator", "access_observed_at"],
        "properties": {
          "manifest_ref": {"type": "string"},
          "manifest_digest": {"$ref": "#/$defs/digest"},
          "source_id": {"type": "string"},
          "source_revision": {"type": "integer", "minimum": 1},
          "exact_locator": {"type": "string"},
          "access_observed_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "independent_source_access": {"enum": ["reaccessed", "not_required_for_alignment_only", "unavailable_blocks_use"]},
    "method_revision": {"type": "string"},
    "findings": {
      "type": "object", "additionalProperties": false,
      "required": ["supports", "does_not_support", "limitations", "counterevidence_refs", "unknowns", "falsifiers"],
      "properties": {
        "supports": {"type": "array", "items": {"type": "string"}},
        "does_not_support": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "counterevidence_refs": {"type": "array", "items": {"type": "string"}},
        "unknowns": {"type": "array", "items": {"type": "string"}},
        "falsifiers": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "result": {"enum": ["pass_exact_scope", "narrow_claim", "reject_claim", "blocked_source_unavailable", "blocked_rights_or_privacy", "unresolved"]},
    "authority_granted": {"const": "candidate_check_only_no_doctrine_or_promotion_authority"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "receipt_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
