{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logos.local/schemas/academic_extensions/source_record.v1.schema.json",
  "title": "Academic Source Record v1",
  "$comment": "An immutable source-identity record, not a claim that the source is correct, canonical, usable, or authoritative.",
  "type": "object",
  "x-governance": {"object_type": "academic_source_record_schema", "trust_zone": "proposed", "lifecycle_status": "draft", "provenance_note": "Created 2026-08-25 for the Academic Extension Contract.", "reason_for_inclusion": "Keep source identity and custody separate from mutable derived projections."},
  "required": ["schema_version", "object_type", "source_record_id", "source_payload", "record_digest", "trust_zone", "lifecycle_status"],
  "properties": {
    "schema_version": {"const": "logos.academic.source-record.v1"},
    "object_type": {"const": "academic_source_record"},
    "source_record_id": {"type": "string", "pattern": "^urn:logos:source:[a-z0-9][a-z0-9:._-]*$"},
    "source_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "title", "version_or_edition", "custodial_identity", "locators", "provenance", "rights", "uncertainty"],
      "properties": {
        "source_kind": {"enum": ["archaeological_report", "manuscript_witness", "critical_edition", "academic_publication", "dataset", "reference_work", "other"]},
        "title": {"type": "string", "minLength": 1},
        "version_or_edition": {"type": "string", "minLength": 1},
        "custodial_identity": {"type": "string", "minLength": 1},
        "locators": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "provenance": {"type": "object", "minProperties": 1, "additionalProperties": true},
        "rights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["access", "quotation", "transformation", "retention", "model_transmission", "embedding", "redistribution", "publication", "review_required"],
          "properties": {
            "access": {"enum": ["allowed", "restricted", "unknown"]},
            "quotation": {"enum": ["allowed", "restricted", "unknown"]},
            "transformation": {"enum": ["allowed", "restricted", "unknown"]},
            "retention": {"enum": ["allowed", "restricted", "unknown"]},
            "model_transmission": {"enum": ["allowed", "restricted", "unknown"]},
            "embedding": {"enum": ["allowed", "restricted", "unknown"]},
            "redistribution": {"enum": ["allowed", "restricted", "unknown"]},
            "publication": {"enum": ["allowed", "restricted", "unknown"]},
            "review_required": {"const": true}
          }
        },
        "uncertainty": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "record_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "trust_zone": {"enum": ["proposed", "learning-sidecar"]},
    "lifecycle_status": {"enum": ["draft", "proposed", "deprecated"]}
  },
  "additionalProperties": false
}
