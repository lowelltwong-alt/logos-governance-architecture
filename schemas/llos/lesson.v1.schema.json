{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logos.local/schemas/llos/lesson.v1.schema.json",
  "title": "Logos Learning Loop Lesson v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lesson_id", "revision", "source_repo", "authority_owner", "category",
    "route", "severity", "constitutional", "status", "summary", "applies_when",
    "does_not_apply_when", "danger_if_misapplied", "evidence_refs",
    "validator_refs", "changed_paths", "enforcement_ref", "prevention",
    "stop_condition", "authority_ceiling", "reading_cost", "irreversibility",
    "blast_radius", "sunset_eligible", "propagation_posture", "source_hashes", "contains_raw_source_payload",
    "contains_theology_claim", "human_review_required"
  ],
  "properties": {
    "lesson_id": {"type": "string", "pattern": "^llos:[a-z0-9][a-z0-9._:-]+$"},
    "revision": {"type": "integer", "minimum": 1},
    "source_repo": {"type": "string", "enum": ["logos-governance-architecture", "logos-scripture-graph", "logos-boundary-literature", "logos-doctrine-genealogy"]},
    "authority_owner": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "route": {"type": "string", "enum": ["governance", "scripture", "boundary", "doctrine", "dad_candidate"]},
    "severity": {"type": "string", "enum": ["P0", "P1", "P2", "P3"]},
    "constitutional": {"type": "boolean"},
    "status": {"type": "string", "enum": ["candidate", "reviewed", "rejected", "superseded"]},
    "summary": {"type": "string", "minLength": 1},
    "applies_when": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "does_not_apply_when": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "danger_if_misapplied": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "validator_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "changed_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "enforcement_ref": {"type": ["string", "null"]},
    "prevention": {"type": "string", "minLength": 1},
    "stop_condition": {"type": "string", "minLength": 1},
    "authority_ceiling": {"type": "string", "enum": ["candidate_only", "workflow_only", "validation_only"]},
    "reading_cost": {"type": "integer", "minimum": 1, "maximum": 5},
    "irreversibility": {"type": "string", "enum": ["low", "medium", "high", "catastrophic"]},
    "blast_radius": {"type": "string", "enum": ["local", "repository", "logos_family"]},
    "sunset_eligible": {"type": "boolean"},
    "propagation_posture": {"type": "string", "enum": ["local_only", "governed_mirror", "dad_metadata_candidate"]},
    "source_hashes": {"type": "array", "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "contains_raw_source_payload": {"const": false},
    "contains_theology_claim": {"const": false},
    "human_review_required": {"const": true},
    "sunset_review_due": {"type": ["string", "null"], "format": "date"},
    "catastrophic_or_irreversible": {"type": "boolean", "default": false}
  },
  "allOf": [
    {
      "if": {"properties": {"severity": {"const": "P0"}}, "required": ["severity"]},
      "then": {"properties": {"sunset_review_due": {"type": "null"}, "sunset_eligible": {"const": false}}}
    },
    {
      "if": {"properties": {"constitutional": {"const": true}}, "required": ["constitutional"]},
      "then": {"properties": {"sunset_review_due": {"type": "null"}, "sunset_eligible": {"const": false}}}
    },
    {
      "if": {"properties": {"catastrophic_or_irreversible": {"const": true}}, "required": ["catastrophic_or_irreversible"]},
      "then": {"properties": {"sunset_review_due": {"type": "null"}, "sunset_eligible": {"const": false}}}
    }
  ]
}
